{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exercise-tracker",
  "compatibility_date": "2026-09-08",
  "main": "worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  }
}